# Copy to .env and fill in. Variables marked (required) make the server
# refuse to start when missing; the others show their default.

NODE_ENV=development
PORT=3000

# MariaDB 10.4 (XAMPP). DB_PASSWORD may be empty but must be present.
DB_HOST=localhost             # (required)
DB_PORT=3306
DB_USER=root                  # (required)
DB_PASSWORD=                  # (required, may be empty)
DB_NAME=fixify                # (required)

JWT_SECRET=change-me-to-a-long-random-string   # (required)
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:8081   # (required)

# Gemini (intake diagnosis). Optional: AI is enabled only when both
# GEMINI_API_KEY and GEMINI_MODEL are set; otherwise the server starts with a
# warning and analysis returns 503. GEMINI_FALLBACK_MODEL is optional: the
# model the analysis hedges to when the main one is slow or fails
# (docs/ai-plan.md §12.2); without it there is no hedge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
